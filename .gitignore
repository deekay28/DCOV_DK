# --- secrets - never commit these ------------------------------------------
deploy/.env
backend/.env
*.env
!*.env.example

# --- Python / backend --------------------------------------------------- #
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# runtime state - databases, uploads, reports, backups, logs generated by
# running the app locally (see backend/app/core/config.py's default paths)
backend/var/
backend/dcov.sqlite*
data/dcov.sqlite*
*.sqlite-wal
*.sqlite-shm
var-*.log
dcov.log
dcov-test-*/

# --- Flutter / Dart ------------------------------------------------------- #
# Generated by `flutter create .` - see docs/FLUTTER_TESTING.md. Regenerate
# on any machine that has the Flutter SDK; don't commit machine-specific
# build output, but DO commit the platform folders themselves once generated
# if the team wants a fully turnkey checkout - remove these two lines if so.
frontend_flutter/build/
frontend_flutter/.dart_tool/
frontend_flutter/.flutter-plugins
frontend_flutter/.flutter-plugins-dependencies
frontend_flutter/.packages
# pubspec.lock is deliberately NOT ignored below - this is an application,
# not a published package, and apps should commit their lockfile for
# reproducible builds across machines/CI. (Packages/libraries are the case
# where you'd ignore it - not the case here.)

# --- Docker / editor / OS -------------------------------------------------- #
*.log
.DS_Store
Thumbs.db
.idea/
*.iml

# .vscode/ is intentionally NOT ignored - settings.json and launch.json are
# checked in on purpose, see docs/VSCODE_SETUP.md

# --- Android release signing - never commit --------------------------------- #
*.jks
*.keystore
**/android/key.properties
