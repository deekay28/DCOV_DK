# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# DCOV backend image. Multi-stage: build deps in one layer, run as non-root.
# Build:  docker build -f deploy/Dockerfile.backend -t dcov-backend:latest ./backend
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# tesseract-ocr + libzbar0 support the optional vision extras (requirements-vision.txt).
# Omit them (and requirements-vision.txt) for a slim, barcode/manual-entry-only image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpq5 default-libmysqlclient-dev tesseract-ocr libzbar0 curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin dcov
WORKDIR /app

COPY requirements.txt requirements-vision.txt ./
ARG INSTALL_VISION=false
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "$INSTALL_VISION" = "true" ]; then pip install --no-cache-dir -r requirements-vision.txt; fi

COPY app ./app
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations

RUN mkdir -p /app/var/uploads /app/var/reports /app/var/backups /data \
    && chown -R dcov:dcov /app /data

USER dcov
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", "--proxy-headers", "--forwarded-allow-ips=*"]
