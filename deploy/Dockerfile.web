# Serves the offline-capable web demo / PWA shell as static files.
# Build:  docker build -f deploy/Dockerfile.web -t dcov-web:latest ./web_demo
FROM nginx:1.27-alpine
COPY . /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/index.html >/dev/null || exit 1
